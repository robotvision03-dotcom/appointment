# Twilio is unused in Iran. Leave empty.

PUBLIC_BASE_URL=http://127.0.0.1:38471
RECEPTIONIST_NUMBER=+989120000000

# Kavenegar SMS: https://panel.kavenegar.com
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

VOSK_MODEL_PATH=./models/vosk-model-fa
PIPER_MODEL_PATH=./models/piper-voice-fa/fa_IR-mana-medium.onnx
PIPER_CONFIG_PATH=./models/piper-voice-fa/fa_IR-mana-medium.onnx.json

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# 0 = never call Ollama (fastest). 14B models are slow on CPU.
OLLAMA_ENABLED=1

DB_PATH=./appointments.db
HOST=0.0.0.0
PORT=38471
LOG_LEVEL=INFO
LOG_DIR=./logs

# Twilio unused in Iran.

PUBLIC_BASE_URL=http://127.0.0.1:38471
RECEPTIONIST_NUMBER=+989120000000

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Shenava CTC on-device. Gooya v1.4 is commercial (no public weights).
SHENAVA_MODEL_ID=Reza2kn/Shenava-Koochik-v1.5
SHENAVA_MODEL_PATH=./models/shenava-koochik-v1.5
SHENAVA_CTC_PATH=./models/shenava-koochik-ctc
SHENAVA_HEAD=ctc
SHENAVA_THREADS=4

# auto | whisper | shenava | gooya — default is nezamisafa/whisper-persian-v4
STT_ENGINE=whisper
WHISPER_MODEL_ID=nezamisafa/whisper-persian-v4
WHISPER_MODEL_PATH=./models/whisper-persian-v4-ct2
WHISPER_CT2_REPO=AlexAnoshka/fast-whisper-persian-v4
# 0 = pick physical cores. More threads is not faster for CTranslate2 int8.
WHISPER_THREADS=0
WHISPER_COMPUTE=int8

# Speech onset in RMS. Raise it when room noise starts the recogniser,
# lower it when a soft voice is never heard.
VAD_MIN_ENERGY=500
GOOYA_API_URL=
GOOYA_API_TOKEN=
GOOYA_TIMEOUT_S=25

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# 1 = local Ollama for replies; 0 = rule-based dialogue only
OLLAMA_ENABLED=0

DB_PATH=./appointments.db
HOST=0.0.0.0
PORT=38471
LOG_LEVEL=INFO
LOG_DIR=./logs

OFFICE_ADDRESS=خیابان ایثار، کوچه خواجه پلاک ۲
OFFICE_HOURS_START=09:00
OFFICE_HOURS_END=17:00

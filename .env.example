# Twilio is not used in Iran (blocked). Keep empty.

# Clinic web URL (local or your Iranian VPS)
PUBLIC_BASE_URL=http://127.0.0.1:38471

# Receptionist mobile for click-to-call handoff (E.164 or 09…)
RECEPTIONIST_NUMBER=+989120000000

# Kavenegar SMS (https://panel.kavenegar.com) — works inside Iran
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Offline Persian models (recommended for microphone voice)
VOSK_MODEL_PATH=./models/vosk-model-fa
PIPER_MODEL_PATH=./models/piper-voice-fa/fa_IR-mana-medium.onnx
PIPER_CONFIG_PATH=./models/piper-voice-fa/fa_IR-mana-medium.onnx.json

# Ollama (optional; dialogue works without it)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

DB_PATH=./appointments.db
HOST=0.0.0.0
PORT=38471
LOG_LEVEL=INFO
LOG_DIR=./logs

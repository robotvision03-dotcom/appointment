# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public URL Twilio can reach (ngrok / production host). Used for Media Stream wss:// and Play URLs.
PUBLIC_BASE_URL=https://your-ngrok-or-domain.example

# Receptionist number for warm transfer (E.164)
RECEPTIONIST_NUMBER=+989120000000

# Paths to models
VOSK_MODEL_PATH=./models/vosk-model-fa
PIPER_MODEL_PATH=./models/piper-voice-fa/fa_IR-mena-medium.onnx
PIPER_CONFIG_PATH=./models/piper-voice-fa/fa_IR-mena-medium.onnx.json

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=persianllama:7b

# Database
DB_PATH=./appointments.db

# Server
HOST=0.0.0.0
PORT=38471
LOG_LEVEL=INFO
LOG_DIR=./logs
